  ; =====================================================
  ; Klipper Vyper XY/XYZ 動作測試完整 G-code
  ; 印表機: Anycubic Vyper (TriGorilla+ / GD32F103RET6)
  ; 軸範圍: X -3~246, Y -10~255, Z -3~265
  ; =====================================================

  ; -----------------------------------------------------
  ; 測試 1: XY 方形軌跡 (50 mm 邊長, 順時針)
  ; -----------------------------------------------------
  G28 X Y                 ; X/Y 歸零
  G90                     ; 絕對座標
  G1 X100 Y100 F3000      ; 移到起點 (左下角), 50 mm/s
  G1 X150 Y100 F6000      ; → 右下角, 100 mm/s
  G1 X150 Y150 F6000      ; → 右上角
  G1 X100 Y150 F6000      ; → 左上角
  G1 X100 Y100 F6000      ; → 回起點 (閉合方形)
  M400                    ; 等待佇列清空

  ; -----------------------------------------------------
  ; 測試 2: XY 模擬揀兩根大頭針 (無 Z, 純 XY 軌跡)
  ; -----------------------------------------------------
  G28 X Y                 ; 重新 X/Y 歸零
  G90
  G1 X80 Y80 F6000        ; 大頭針 1 位置
  G4 P500                 ; 停 0.5s 模擬夾取
  G1 X80 Y200 F6000       ; 放置點 1
  G4 P500                 ; 停 0.5s 模擬釋放
  G1 X200 Y80 F6000       ; 大頭針 2 位置
  G4 P500
  G1 X200 Y200 F6000      ; 放置點 2
  G4 P500
  G28 X Y                 ; 再次 X/Y 歸零
  M400

  ; -----------------------------------------------------
  ; 測試 3: XYZ 模擬揀大頭針兩次, 放置點皆為 (0,0)
  ;         Z 移動採用「travel=15, pick/drop=5」
  ; -----------------------------------------------------
  G28                     ; 完整 XYZ 歸零 (safe_z_home + probe)
  G90
  G1 Z15 F900             ; 抬升至安全高度

  ; -- 第 1 次取放 --
  G1 X80 Y80 F6000        ; 移到大頭針 1
  G1 Z5 F600              ; 下降揀取
  G4 P500
  G1 Z15 F600             ; 抬升
  G1 X0 Y0 F6000          ; 移到放置點 (0,0)
  G1 Z5 F600              ; 下降放下
  G4 P500
  G1 Z15 F600             ; 抬升

  ; -- 第 2 次取放 --
  G1 X200 Y200 F6000      ; 移到大頭針 2
  G1 Z5 F600              ; 下降揀取
  G4 P500
  G1 Z15 F600             ; 抬升
  G1 X0 Y0 F6000          ; 移到放置點 (0,0)
  G1 Z5 F600              ; 下降放下
  G4 P500
  G1 Z15 F600             ; 抬升

  G28 X Y                 ; X/Y 歸零 (Z 保留在 15mm)
  M400

  ; -----------------------------------------------------
  ; 收尾
  ; -----------------------------------------------------
  M84                     ; 關閉所有馬達 (釋放扭力)
